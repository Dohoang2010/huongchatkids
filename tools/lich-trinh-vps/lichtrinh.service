[Unit]
Description=Lich lam viec - nhieu thanh vien (quanlylichtrinh.site)
After=network.target postgresql.service

[Service]
Type=simple
User=lichtrinh
WorkingDirectory=/opt/lichtrinh
EnvironmentFile=/etc/lichtrinh.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Thư mục /var/lib/lichtrinh (ảnh, video, tệp gửi trong chat) – ghi được dù ProtectSystem=strict
StateDirectory=lichtrinh

[Install]
WantedBy=multi-user.target
